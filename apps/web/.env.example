# NextAuth v5. trustHost is enabled in code (auth runs on many tenant subdomains).
AUTH_SECRET="change-me-in-production-min-32-chars"

# NestJS API
INTERNAL_API_URL="http://localhost:3000/api"   # server-side
NEXT_PUBLIC_API_URL="http://localhost:3000/api" # browser

# Domain layout
#   apex   (new-hospital sign-up):  <protocol>://<root>
#   tenant (a hospital's workspace): <protocol>://<slug>.<root>
NEXT_PUBLIC_ROOT_DOMAIN="localhost"   # prod: oudmed.com
NEXT_PUBLIC_APP_PROTOCOL="http"       # prod: https

# Object-storage origin(s) allowed in next/image (comma-separated, no wildcards).
# Match the API's S3_PUBLIC_ENDPOINT in dev; your file CDN host in prod.
NEXT_PUBLIC_STORAGE_ORIGIN="http://localhost:9000"
