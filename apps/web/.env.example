# NextAuth v5. trustHost is enabled in code (auth runs on many tenant subdomains).
# The value below is fine for local dev; generate a real one for a deployment
# (`node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).
AUTH_SECRET="dev-only-nextauth-secret-min-32-characters-long"

# NestJS API
INTERNAL_API_URL="http://localhost:3000/api"   # server-side
NEXT_PUBLIC_API_URL="http://localhost:3000/api" # browser

# Domain layout
#   apex   (new-hospital sign-up):  <protocol>://<root>
#   tenant (a hospital's workspace): <protocol>://<slug>.<root>
NEXT_PUBLIC_ROOT_DOMAIN="localhost"   # prod: oudmed.com
NEXT_PUBLIC_APP_PROTOCOL="http"       # prod: https

# Object-storage origin(s) allowed in next/image (comma-separated, no wildcards).
# Match the API's S3_PUBLIC_ENDPOINT in dev; your file CDN host in prod.
NEXT_PUBLIC_STORAGE_ORIGIN="http://localhost:9000"

# Error tracking (Sentry). Optional - leave both blank to disable entirely.
# SENTRY_DSN is read at runtime (server-side errors); NEXT_PUBLIC_SENTRY_DSN is
# baked in at build time (browser errors) - same project, same DSN value works
# for both, they're just two different env vars because of when each is read.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Marketing site "Contact Us" form's Cloudflare Turnstile widget. Deliberately
# NOT NEXT_PUBLIC_-prefixed even though the value is safe to expose (Turnstile
# requires it in page HTML) - it's read server-side in app/(marketing)/contact/
# page.tsx (a Server Component) and passed down as a prop, so it's a plain
# runtime env var rather than one baked in at build time. The matching secret
# key lives only in apps/api's env - never here.
TURNSTILE_SITE_KEY=""
