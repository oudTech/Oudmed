# Production environment for the web app (Fly.io). See docs/DEPLOYMENT.md for
# the full go-live runbook. Every value below is a placeholder. Vars marked
# "GENERATE" must be freshly created for this environment, never reused.
#
# NEXT_PUBLIC_* vars are baked in at Docker BUILD time (passed as --build-arg -
# see fly.toml's [build.args] and the Dockerfile header). Changing one after
# the fact needs a rebuild + redeploy, not just a restart. Everything else
# here is a Fly *secret* (`fly secrets set NAME=value`), never committed.

# GENERATE: 32+ random bytes, unique to production, different from staging.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="<generate-a-new-random-value-for-production>"

PORT="3001"

# Server-to-server call to the API - the public URL, not an internal hostname,
# so this is correct regardless of whether the two services share a network.
INTERNAL_API_URL="https://api.oudmed.com/api"

# ── Baked in at build time (fly.toml [build.args]) ──
NEXT_PUBLIC_API_URL="https://api.oudmed.com/api"
NEXT_PUBLIC_ROOT_DOMAIN="oudmed.com"
NEXT_PUBLIC_APP_PROTOCOL="https"
# The R2 public origin - same host as the API's S3_PUBLIC_ENDPOINT.
NEXT_PUBLIC_STORAGE_ORIGIN="https://<public-r2-dev-or-custom-domain>"
# A client DSN is meant to be public - safe to bake into the bundle and commit
# in fly.toml directly (see fly.toml's own comment), unlike every other secret
# here.
NEXT_PUBLIC_SENTRY_DSN="https://<key>@o<org-id>.ingest.<region>.sentry.io/<project-id>"

# ── Fly secrets (runtime, never baked in) ──
# Server-side error reporting - same DSN value as NEXT_PUBLIC_SENTRY_DSN is
# fine, these are two vars only because of when each is read.
SENTRY_DSN="https://<key>@o<org-id>.ingest.<region>.sentry.io/<project-id>"
# Cloudflare Turnstile site key for the marketing "Contact Us" form - read
# server-side (deliberately not NEXT_PUBLIC_-prefixed). Without it the contact
# form renders but the widget never loads; not a boot failure, easy to miss.
TURNSTILE_SITE_KEY="<turnstile-site-key>"
