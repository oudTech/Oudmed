# development | production. Controls fail-fast strictness (validateEnv) and
# whether the API refuses to boot when object storage or APP_DATABASE_URL is missing.
NODE_ENV="development"

# Owner connection - prisma CLI, migrations, `pnpm seed`, `pnpm prisma:rls`,
# `pnpm db:setup-role`. Has full DDL rights.
DATABASE_URL="postgresql://oudhealth:oudhealth@localhost:5432/oudhealth?schema=public"

# The API process connects as a dedicated NOSUPERUSER / NOBYPASSRLS role so
# PostgreSQL row-level security is actually enforced. Locally, `docker compose up`
# already creates this role (docker/postgres-init/01-app-role.sql) with the
# password below, so these defaults work as-is - no `pnpm db:setup-role` needed.
# For a managed database, run `pnpm db:setup-role` once (it reads APP_DB_PASSWORD)
# and set APP_DATABASE_URL's password to match.
APP_DB_PASSWORD="oudhealth-app-dev"
APP_DATABASE_URL="postgresql://oudhealth_app:oudhealth-app-dev@localhost:5432/oudhealth?schema=public"

PORT=3000

# Error tracking (Sentry). Optional - leave blank to disable entirely (errors
# still go to stdout/stderr either way). Only 5xx / unhandled exceptions are
# reported, via the global exception filter - not routine 4xx validation errors.
SENTRY_DSN=""

# Swagger UI at /docs. On by default outside production. Set to "true" to also
# expose it in production (only behind an authenticated gateway).
ENABLE_SWAGGER=""

# Domain layout: apex (new-hospital sign-up) = <protocol>://<root>
#                tenant workspace             = <protocol>://<slug>.<root>
APP_ROOT_DOMAIN="localhost:3001"   # prod: oudmed.com
APP_PROTOCOL="http"                # prod: https
FRONTEND_URL="http://localhost:3001"

# Signs all API tokens (pending / session). 32+ random chars. The value below is
# fine for local dev; generate a real one for any shared/deployed environment
# (`node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).
JWT_SECRET="dev-only-jwt-secret-min-32-characters-long-xyz"

# Transactional email. Leave RESEND_API_KEY blank in dev to print emails to the console.
RESEND_API_KEY=""
EMAIL_FROM="Oudmed <onboarding@resend.dev>"

# Object storage. Dev: `docker compose up -d minio minio-setup` (console at :9001).
# Prod: point at S3 / R2 / Spaces and set S3_PUBLIC_ENDPOINT to the browser-facing host.
S3_ENDPOINT="http://localhost:9000"
S3_PUBLIC_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="oudhealth-dev"
S3_ACCESS_KEY="oudhealth"
S3_SECRET_KEY="oudhealth-dev-secret"
S3_FORCE_PATH_STYLE="true"
# Only needed when the public/browser-facing endpoint has a different URL shape
# than the private one - e.g. Cloudflare R2's public pub-xxx.r2.dev host is
# already scoped to one bucket and must NOT have the bucket name in the path,
# unlike R2's own private API endpoint. Leave unset to reuse S3_FORCE_PATH_STYLE
# (correct for MinIO, where both endpoints are the same shape); set to "false"
# for R2's public host.
S3_PUBLIC_FORCE_PATH_STYLE=""
FILE_MAX_MB=20

# Malware scanning (optional). Point at a clamd TCP endpoint to scan every upload;
# leave CLAMAV_HOST blank to skip scanning (uploads are recorded scanStatus=SKIPPED).
CLAMAV_HOST=""
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=8000
