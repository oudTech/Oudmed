# development | production. Controls fail-fast strictness (validateEnv) and
# whether the API refuses to boot when object storage or APP_DATABASE_URL is missing.
NODE_ENV="development"

# Owner connection - prisma CLI, migrations, `pnpm seed`, `pnpm prisma:rls`,
# `pnpm db:setup-role`. Has full DDL rights.
DATABASE_URL="postgresql://oudhealth:oudhealth@localhost:5432/oudhealth?schema=public"

# The API process connects as a dedicated NOSUPERUSER / NOBYPASSRLS role so
# PostgreSQL row-level security is actually enforced. One-time:
#   1. put a password in APP_DB_PASSWORD
#   2. `pnpm db:setup-role`   (creates the `oudhealth_app` role + grants)
#   3. set APP_DATABASE_URL to match, then start the API
# Falls back to DATABASE_URL when APP_DATABASE_URL is unset (first-run convenience).
APP_DB_PASSWORD=""
APP_DATABASE_URL="postgresql://oudhealth_app:CHANGE_ME@localhost:5432/oudhealth?schema=public"

PORT=3000

# Swagger UI at /docs. On by default outside production. Set to "true" to also
# expose it in production (only behind an authenticated gateway).
ENABLE_SWAGGER=""

# Domain layout: apex (new-hospital sign-up) = <protocol>://<root>
#                tenant workspace             = <protocol>://<slug>.<root>
APP_ROOT_DOMAIN="localhost:3001"   # prod: oudmed.com
APP_PROTOCOL="http"                # prod: https
FRONTEND_URL="http://localhost:3001"

# Signs all API tokens (pending / session). 32+ random chars.
JWT_SECRET="change-me-in-production-min-32-chars-secret"

# Transactional email. Leave RESEND_API_KEY blank in dev to print emails to the console.
RESEND_API_KEY=""
EMAIL_FROM="Oudmed <onboarding@resend.dev>"

# Object storage. Dev: `docker compose up -d minio minio-setup` (console at :9001).
# Prod: point at S3 / R2 / Spaces and set S3_PUBLIC_ENDPOINT to the browser-facing host.
S3_ENDPOINT="http://localhost:9000"
S3_PUBLIC_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="oudhealth-dev"
S3_ACCESS_KEY="oudhealth"
S3_SECRET_KEY="oudhealth-dev-secret"
S3_FORCE_PATH_STYLE="true"
FILE_MAX_MB=20

# Malware scanning (optional). Point at a clamd TCP endpoint to scan every upload;
# leave CLAMAV_HOST blank to skip scanning (uploads are recorded scanStatus=SKIPPED).
CLAMAV_HOST=""
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=8000
