# Production environment for the API (Render). See docs/DEPLOYMENT.md for the
# full go-live runbook this file supports. Every value below is a placeholder -
# nothing here is a real secret, and none of these should ever be copied from
# a dev/staging .env. Vars marked "GENERATE" must be freshly created for this
# environment, never reused from anywhere else.

NODE_ENV="production"

# ── Database (Neon - the NEW production project, not the staging one) ──
# Owner connection: runs migrate/rls on every boot (docker-entrypoint.sh).
DATABASE_URL="postgresql://<owner-user>:<owner-password>@<neon-host>/<db>?sslmode=require"
# GENERATE: a strong random password for the oudhealth_app role (pnpm db:setup-role
# reads this). Not the same password as any other environment's app role.
APP_DB_PASSWORD="<generate-a-strong-password>"
# The oudhealth_app role's own connection string, same host/db, different user.
APP_DATABASE_URL="postgresql://oudhealth_app:<same-password-as-above>@<neon-host>/<db>?sslmode=require"

PORT="3000"

# Error tracking. Production DSN from the Sentry project (see docs/DEPLOYMENT.md
# Part 2 item 7) - a different project/DSN from staging, so errors don't mix.
SENTRY_DSN="https://<key>@o<org-id>.ingest.<region>.sentry.io/<project-id>"

# Swagger stays off in production unless explicitly turned on behind an
# authenticated gateway - leave this false.
ENABLE_SWAGGER="false"

# Domain layout - the real production domain.
APP_ROOT_DOMAIN="oudmed.com"
APP_PROTOCOL="https"
FRONTEND_URL="https://oudmed.com"

# GENERATE: 32+ random bytes, unique to production.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="<generate-a-new-random-value-for-production>"

# Transactional email (Resend) - see docs/DEPLOYMENT.md Part 2 item 6 for
# domain verification. Required for real password-reset/verification email;
# leave RESEND_API_KEY unset only if you deliberately want links printed to
# the Render logs instead (not recommended once a real hospital is live).
RESEND_API_KEY="<resend-api-key>"
EMAIL_FROM="Oudmed <noreply@oudmed.com>"

# Object storage - Cloudflare R2, the production bucket (separate from any
# staging bucket).
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_PUBLIC_ENDPOINT="https://<public-r2-dev-or-custom-domain>"
S3_REGION="auto"
S3_BUCKET="oudhealth-prod"
S3_ACCESS_KEY="<r2-access-key-id>"
S3_SECRET_KEY="<r2-secret-access-key>"
S3_FORCE_PATH_STYLE="true"
S3_PUBLIC_BUCKET_ENDPOINT="true"
FILE_MAX_MB="20"

# Malware scanning - optional, off for the pilot (no reachable clamd host).
CLAMAV_HOST=""
CLAMAV_PORT="3310"
CLAMAV_TIMEOUT_MS="8000"

# Subscription card payments (Paystack) - optional at launch. Leave blank and
# card checkout returns a clear 503 PAYSTACK_NOT_CONFIGURED; bank transfer
# (manually confirmed) still works with nothing set here. Add live keys later
# with no code change needed.
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_WEBHOOK_SECRET=""

# Marketing site "Contact Us" form. REQUIRED - the API refuses to boot in
# production without this (validateEnv). Get it from the Cloudflare Turnstile
# dashboard; the matching site key is a separate var on the web app.
TURNSTILE_SECRET_KEY="<turnstile-secret-key>"
CONTACT_INQUIRY_TO="<where-contact-form-submissions-should-go>"
